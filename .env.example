# Copy to .env.local for local development. Never commit real values.
# demo = forms validate and show success, nothing is sent or stored
# live = forms also run rate limit + Turnstile and email the lead (set the keys below)
# Full go-live steps: docs/SECURITY.md
SITE_MODE=demo

# Public address of the site (used for share previews, sitemap and robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live mode only (leave empty in demo)
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
